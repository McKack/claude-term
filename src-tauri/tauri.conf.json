{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauracle",
  "version": "0.1.5",
  "identifier": "no.arctim.clauracle",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Clauracle", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../plugin/": "plugin/" },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
